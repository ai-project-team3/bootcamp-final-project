# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (judge + story). One model, two effort settings. ---
# Model id is a setting, not a constant: W1 measurement may swap it.
LLM_PROVIDER=openai            # openai | anthropic | mistral
LLM_MODEL=gpt-6-luna            # 09-25 확정 — 품질 동률 이상, 값 반값 (results.md)
LLM_API_KEY=
LLM_EFFORT_JUDGE=none          # judge must answer fast
LLM_EFFORT_STORY=high          # story can think

# --- STT ---
STT_PROVIDER=local             # local (self-hosted faster-whisper) | openai
STT_MODEL=large-v3            # 09-23 확정 — 3~6세에서 turbo 대비 CER 절반
STT_API_KEY=
WHISPER_SERVER_URL=http://127.0.0.1:9000

# --- server ---
PORT=8000

# Jev (TypeSafe AI) — 판정만 하는 모델. console.typesafe.ai 에서 발급
TYPESAFE_API_KEY=
