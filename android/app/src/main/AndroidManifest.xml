<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 기기 점검용 음성 인식 엔진 조회 (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- allowBackup="false" (09-23 박진웅). 켜 두면 앱 데이터(아이가 녹음한 소리 포함)가
         구글 드라이브로 나간다 — 처리방침 §2 "녹음한 소리는 기기 밖으로 나가지 않습니다"와 부딪힌다.

         ⚠️ 처리방침은 소리를 **두 가지로 나눈다** (09-25에 이 주석만 보고 모순이라 읽은 일이 있어 적어 둔다):
           · **말한 음성** (질문에 답한 말)        → **우리 서버까지** 간다. 전사하고 즉시 지운다
           · **녹음한 소리** (울음소리 등 효과음)  → **기기 밖으로 안 나간다**  ← 이 줄이 위 근거다
         둘을 섞으면 "음성이 서버로 간다"는 앱 화면 문구(ui/Consent.kt 마이크 고지)와 부딪히는 것처럼 보인다.
         부딪히지 않는다. 서로 다른 것을 말하고 있다. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuppetDemo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.PuppetDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <!-- 기기 점검 — 실기기 VAD·STT·TTS 측정 원본. **지우지 않는다**(`guidelines/9` §9-2:
             나중에 본체로 옮길 원본). 다만 **런처 아이콘은 뺐다** (09-23 박진웅) — 스토어에 올리는 앱에
             아이콘이 둘 뜨면 안 된다. adb 로만 띄운다:
             adb shell am start -n kr.clap.otto/com.example.finalproject_demo.DiagnosticsActivity -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="true"
            android:label="기기 점검" />
    </application>

</manifest>
