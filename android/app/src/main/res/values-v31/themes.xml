<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 시스템 스플래시도 같은 크림색으로 → 곧바로 CLAP 화면이 이어진다 -->
    <style name="Theme.PuppetDemo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <!-- 09-29 켜는 순간(시스템 스플래시)부터 전체 화면 — 상태 표시줄 없이, 카메라 구멍 쪽까지 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <!-- 09-29 시스템 스플래시의 앱 아이콘을 지운다 — 켜면 아이콘 화면 → CLAP 화면으로 스플래시가 두 번 나왔다 -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
