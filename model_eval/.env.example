# 실제 값이 들어간 .env는 절대 커밋하지 마세요.
# 조장이 팀용 키를 주면 이 파일을 .env로 복사한 뒤 값만 채웁니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# 팀 문서의 원화 환산 가정. 필요하면 실행 당일 환율로 변경.
USD_KRW=1400

# API 모델 ID가 바뀌거나 팀에서 snapshot을 고정할 때만 수정하세요.
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_NANO_MODEL=gpt-5-nano
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
MISTRAL_SMALL_MODEL=mistral-small-2603

# OpenAI reasoning 설정을 팀에서 바꾸고 싶을 때만 사용.
OPENAI_LUNA_REASONING_EFFORT=none
OPENAI_NANO_REASONING_EFFORT=minimal

# 보통 수정하지 않음. 사내 프록시/리전 엔드포인트가 있을 때만 사용.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
