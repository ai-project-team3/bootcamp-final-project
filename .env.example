# 복사해서 `.env`로 쓴다. `.env`는 gitignore에 있다 — 절대 커밋하지 않는다.
#
#   cp .env.example .env
#
# 이 파일은 **레포 루트**에 있어야 한다. 백엔드(`backend/app/config.py`)와 평가 하네스(`eval/config.py`)가
# **둘 다 이 한 파일**을 읽는다. 서버 PC 는 `C:\otto\.env` 를 Docker 가 읽는다(`docs/서버_세팅.md`).
# 이름은 `config.py` 의 설정 이름을 대문자로 쓴 것이다. 비워 두면 그 설정의 기본값을 쓴다.
#
# 키는 각자 발급한다. 카톡·디스코드에 붙여넣지 않는다.

# --- 키 ---
OPENAI_API_KEY=                 # 판정 · 대사 · 책 · 이미지 검사 · 마스코트 목소리
TYPECAST_API_KEY=               # TTS_PROVIDER=typecast 일 때만
TYPESAFE_API_KEY=               # Jev — 측정 하네스(eval/bench_jev.py) · 서버 판정(JUDGE_PROVIDER=jev)
JUDGE_JEV_MODES=                # Jev 판정을 쓸 모드(쉼표) — 예: story · 비우면 전부 루나 · 내부 테스트에서만 (docs/배경_조각_목록.md §6-4)
MISTRAL_API_KEY=                # 평가 하네스 비교용 (없으면 NO KEY 로 건너뜀)

# --- 서버 ---
MOCK=0                          # 1 = 키 · GPU 없이 명세 모양의 고정 답 (앱 연결용)
LLM_MODEL=gpt-6-luna            # 09-25 확정 (results.md) — 모델 ID 는 상수로 박지 않는다
STT_MODEL=large-v3              # 09-23 확정 — 3~6세에서 turbo 대비 CER 절반
STT_UNSURE_BELOW=-0.8          # 10-06 #149 — 이 아래면 폰이 한 번 더 묻는다 (발화 16% · 그중 82% 가 실제로 틀린 답)
COMFY_URL=http://127.0.0.1:8188 # 그림 — 팀 서버는 PC2 (docs/서버_세팅.md)
TTS_PROVIDER=openai             # openai | typecast | elevenlabs (10-01 조장: 당분간 openai 단독)
ELEVENLABS_API_KEY=             # TTS_PROVIDER=elevenlabs 일 때 · eval/bench_tts_eleven_v4.py 측정에도
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICE_ID=            # 귀 판정으로 고른 한국어 목소리
TTS_FALLBACK=                   # 비우면 대신하는 쪽 없음
TYPECAST_OPT_IN=false           # true = 타입캐스트 선택 동의한 집만 타입캐스트 목소리(10-06). 동의 안 한 집은 TTS_PROVIDER 가 typecast 여도 타입캐스트로 안 감

# --- 평가 하네스 · 선택적 모델 ID override ---
# 공식 고정 버전을 기본값으로 쓰며, 콘솔에서 다른 ID를 확인한 경우에만 바꾼다.
MISTRAL_SMALL_MODEL=mistral-small-2603
MINISTRAL_3B_MODEL=ministral-3b-2512

# --- 엔드포인트 모니터 관리자 로그인 (backend/app/admin.py · 10-07) ---
# 비워 두면 모니터 · /stats 가 잠긴다(기본 비밀번호 없음). 값은 `py backend/scripts/admin_password.py` 로 만든다
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# 선택 — 비우면 비밀번호 해시로 세션을 서명한다(비밀번호를 바꾸면 모두 로그아웃)
ADMIN_SESSION_SECRET=
