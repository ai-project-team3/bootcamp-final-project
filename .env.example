# 복사해서 `.env`로 쓴다. `.env`는 gitignore에 있다 — 절대 커밋하지 않는다.
#
#   cp .env.example .env
#
# 이 파일은 **레포 루트**에 있어야 한다. `eval/config.py`가 여기서 읽는다.
# 백엔드는 따로다 — `backend/.env.example` 참고.
#
# 키는 각자 발급한다. 카톡·디스코드에 붙여넣지 않는다.

# --- 평가 하네스가 쓰는 키 ---
# 없는 키의 모델은 preflight가 NO KEY로 건너뛴다. 전부 있을 필요는 없다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for an org-level key. A workspace-scoped key needs nothing here.
# Without it an org-level key fails every call with HTTP 400.
ANTHROPIC_WORKSPACE_ID=
MISTRAL_API_KEY=

# --- 선택적 모델 ID override ---
# 공식 고정 버전을 기본값으로 쓰며, 콘솔에서 다른 ID를 확인한 경우에만 바꾼다.
MISTRAL_SMALL_MODEL=mistral-small-2603
MINISTRAL_3B_MODEL=ministral-3b-2512

# --- 참고 ---
# 모델 ID는 상수로 박지 않는다. eval/model_catalog.json이 들고 있고,
# 러너는 --model 인자로 받는다. 측정이 표를 바꾼다.
